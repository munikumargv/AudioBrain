{
  "name": "SafeSound AI",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "bash scripts/codespace-start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "SafeSound dashboard", "onAutoForward": "openBrowser" }
  }
}
